#######################################################################
# ENVIRONMENT: DEVELOPMENT (DEV)
#
# Purpose:
# - Used for daily development and feature implementation.
# - Enables debugging, verbose logs, hot reload.
#
# Characteristics:
# - Connects to DEV backend.
# - Data may be reset at any time.
# - App name usually includes [DEV] prefix.
#
#######################################################################
# --- App Info ---
FLAVOR=DEV                              # Environment name (DEV / UAT / PRD)
PACKAGE_NAME=co.yourcompany.appname     # Android package name (applicationId in build.gradle)
BUNDLE_ID=co.yourcompany.appname        # iOS bundle ID (unique in Apple Developer)
APPLE_TEAM_ID=XXXXXXXXXX                # Apple Developer Team ID
APP_NAME=[DEV]YourAppName               # App display name (shown on device)

# --- Backend Config ---
API_URL="https://your-api-domain.com/api/v1"    # Backend API URL for this environment
API_KEY=xdev-api-key                            # Can stay the same if shared across environments
API_SECRET=xdev-api-secret                      # Can stay the same if shared across environments

# --- Google Sign-In ---
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.xxxxxxxx    # Found in GoogleService-Info.plist (iOS)
GOOGLE_SERVER_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com      # Found in Google Cloud Console (OAuth client)

# --- Apple Sign-In ---
APPLE_CLIENT_ID=co.yourcompany.appname.signin                                       # Apple Sign-In Client ID
APPLE_REDIRECT_URL="https://your-api-domain.com/callbacks/sign_in_with_apple"       # Redirect URL for Apple Sign-In

# --- Facebook Sign-In ---
FACEBOOK_APP_ID=123456789012345           # Facebook App ID (from Facebook Developer)
FACEBOOK_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx # Facebook App secret or client token

# --- Google Maps ---
MAP_API_KEY=AIzaSyXXXXXXXXXXXX            # Google Maps API key
