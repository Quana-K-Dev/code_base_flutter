#######################################################################
# ENVIRONMENT: USER ACCEPTANCE TESTING (UAT)
#
# Purpose:
# - Used for business validation and end-to-end testing.
#
# Characteristics:
# - Backend is close to production.
# - Debugging is limited.
# - App name usually includes [UAT] prefix.
#
#######################################################################
# --- App Info ---
FLAVOR=UAT
PACKAGE_NAME=your.bundle.uat
BUNDLE_ID=your.package.uat
APPLE_TEAM_ID=APPLETEAMID
APP_NAME=[UAT]YourAppName

# --- Backend Config ---
API_URL="https://uat.example.tld/api/v1"