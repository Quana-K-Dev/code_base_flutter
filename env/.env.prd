#######################################################################
# ENVIRONMENT: PRODUCTION (PRD)
#
# Purpose:
# - Used for App Store / Play Store release.
#
# Characteristics:
# - Highest security level.
# - Debugging disabled.
# - App name has NO environment prefix.
#
#######################################################################
# --- App Info ---
FLAVOR=PRD
PACKAGE_NAME=your.bundle.id
BUNDLE_ID=your.package.name
APPLE_TEAM_ID=APPLETEAMID
APP_NAME=[PRD]YourAppName

# --- Backend Config ---
API_URL="https://api.example.tld/api/v1"